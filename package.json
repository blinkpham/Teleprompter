{
  "name": "teleprompter",
  "version": "0.1.0",
  "description": "Offline prompt library and shorthand reference",
  "type": "module",
  "main": "out/main/index.js",
  "author": "Teleprompter",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test:logic": "vitest run",
    "test:helper": "vitest run src/core",
    "typecheck:helper": "tsc --noEmit -p tsconfig.helper.json",
    "helper:build": "vite build --config vite.helper.config.ts",
    "helper": "npm run helper:build && node out/helper/teleprompter-helper.js"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.3.0",
    "electron-vite": "5.0.0",
    "lucide-react": "1.45.0",
    "motion": "^13.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "7.3.6"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.13",
    "@types/react-dom": "19.2.3",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
