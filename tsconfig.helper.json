{
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "src/core/**/*.ts",
    "src/shared/**/*.ts",
    "src/content/**/*.ts",
    "src/engine/**/*.ts",
    "src/main/draft-store.ts"
  ]
}
